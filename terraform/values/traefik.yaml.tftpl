deployment:
  replicas: 1

ingressClass:
  enabled: true
  isDefaultClass: false
  name: traefik

gateway:
  enabled: false

providers:
  kubernetesCRD:
    enabled: true
  kubernetesIngress:
    enabled: true

ports:
  web:
    nodePort: ${http_node_port}
  websecure:
    nodePort: ${https_node_port}

service:
  spec:
    type: NodePort

nodeSelector:
  workload: apps

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 256Mi

accessLog:
  enabled: true
