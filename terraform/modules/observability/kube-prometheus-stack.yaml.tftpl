fullnameOverride: kps

crds:
  enabled: true

defaultRules:
  create: true
  rules:
    etcd: false
    kubeControllerManager: false
    kubeSchedulerAlerting: false
    kubeSchedulerRecording: false
    kubeProxy: false
    node: false
    nodeExporterAlerting: false
    nodeExporterRecording: false
    windows: false

additionalPrometheusRulesMap:
  beacon:
    groups:
      - name: beacon
        rules:
          - alert: BeaconDown
            expr: sum(up{job="beacon"}) < 1
            for: 1m
            labels:
              severity: critical
            annotations:
              summary: No Beacon replica is being scraped successfully
          - alert: BeaconHighErrorRate
            expr: sum(rate(http_server_requests_seconds_count{namespace="beacon",status=~"5.."}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{namespace="beacon"}[5m])), 1e-9) > 0.05
            for: 5m
            labels:
              severity: warning
            annotations:
              summary: More than 5% of Beacon requests return 5xx
          - alert: BeaconPodRestarting
            expr: increase(kube_pod_container_status_restarts_total{namespace="beacon"}[15m]) > 2
            labels:
              severity: warning
            annotations:
              summary: A Beacon container restarted more than twice in 15 minutes

alertmanager:
  enabled: false

nodeExporter:
  enabled: false

kubeEtcd:
  enabled: false
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeProxy:
  enabled: false

kube-state-metrics:
  nodeSelector:
    workload: apps
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 96Mi

prometheusOperator:
  nodeSelector:
    workload: apps
  resources:
    requests:
      cpu: 20m
      memory: 48Mi
    limits:
      cpu: 200m
      memory: 128Mi
  admissionWebhooks:
    patch:
      nodeSelector:
        workload: apps

prometheus:
  prometheusSpec:
    nodeSelector:
      workload: apps
    retention: "${retention}"
    retentionSize: 2GB
    scrapeInterval: 30s
    evaluationInterval: 30s
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    probeSelectorNilUsesHelmValues: false
    resources:
      requests:
        cpu: 100m
        memory: 384Mi
      limits:
        cpu: "1"
        memory: 768Mi
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: "${storage_class}"
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 4Gi
  additionalServiceMonitors:
    - name: beacon
      selector:
        matchLabels:
          app.kubernetes.io/name: beacon
      namespaceSelector:
        matchNames:
          - "${ns_app}"
      endpoints:
        - port: http
          path: /actuator/prometheus
          interval: 15s
  additionalPodMonitors:
    - name: traefik
      selector:
        matchLabels:
          app.kubernetes.io/name: traefik
      namespaceSelector:
        matchNames:
          - "${ns_ingress}"
      podMetricsEndpoints:
        - port: metrics
          path: /metrics
          interval: 15s

grafana:
  testFramework:
    enabled: false
  admin:
    existingSecret: "${grafana_secret}"
    userKey: admin-user
    passwordKey: admin-password
  nodeSelector:
    workload: apps
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: "1"
      memory: 384Mi
  ingress:
    enabled: true
    ingressClassName: traefik
    hosts:
      - "${grafana_hostname}"
  grafana.ini:
    server:
      root_url: "http://${grafana_hostname}"
    plugins:
      preinstall_disabled: true
    analytics:
      reporting_enabled: false
      check_for_updates: false
    users:
      allow_sign_up: false
    auth.anonymous:
      enabled: false
  defaultDashboardsEnabled: true
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      labelValue: "1"
      searchNamespace: "${ns_monitoring}"
    datasources:
      enabled: true
      alertmanager:
        enabled: false
  additionalDataSources:
    - name: Loki
      uid: loki
      type: loki
      access: proxy
      url: "http://loki.${ns_monitoring}.svc.cluster.local:3100"
      isDefault: false
